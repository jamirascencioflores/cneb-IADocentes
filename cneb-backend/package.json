{
  "name": "cneb-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/presentation/server.ts",
    "build": "pnpm typecheck && tsup src/presentation/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "tsx src/infrastructure/database/scripts/run-migrations-and-seeds.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "docx": "^9.13.0",
    "docxtemplater": "^3.71.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
