NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cneb
DATABASE_MAX_CONNECTIONS=20
REDIS_URL=redis://localhost:6379
# Replace each placeholder with an independent random secret (at least 32 characters).
JWT_ACCESS_SECRET=replace-with-an-independent-random-secret
JWT_REFRESH_SECRET=replace-with-another-independent-random-secret
COOKIE_SECRET=replace-with-a-third-independent-random-secret
JWT_ACCESS_EXPIRATION_IN_MINUTES=15
JWT_REFRESH_EXPIRATION_IN_DAYS=7
LLM_PROVIDER=gemini
LLM_API_KEY=replace-with-your-gemini-api-key
# Set a model available to your Google account.
LLM_MODEL=replace-with-your-available-model
CORS_ORIGIN=http://localhost:5173
